WITH base AS (
    SELECT
        lotnumber,
        trigger_id,
        trigger_date,
        basictype,
        cometsopnumber,
        newopnumber,
        CASE
            WHEN newopnumber    = '2055' THEN 'IN'
            WHEN cometsopnumber = '2055' THEN 'OUT'
        END AS move_type,
        CASE
            WHEN newopnumber    = '2055' THEN cometsopnumber
            WHEN cometsopnumber = '2055' THEN newopnumber
        END AS pe_gate
    FROM trigger_table
    WHERE lotnumber LIKE 'ZA%'
      AND cometsopnumber <> '(null)'
      AND newopnumber   <> '(null)'
      AND ('2055' IN (cometsopnumber, newopnumber))
),
sequenced AS (
    SELECT
        b.*,
        SUM(CASE WHEN move_type = 'IN' THEN 1 ELSE 0 END)
            OVER (
                PARTITION BY lotnumber, pe_gate
                ORDER BY trigger_date, trigger_id
            ) AS grp
    FROM base b
),
paired AS (
    SELECT
        lotnumber,
        basictype,
        pe_gate,
        grp,
        MIN(CASE WHEN move_type = 'IN'  THEN trigger_date END) AS movein,
        MIN(CASE WHEN move_type = 'OUT' THEN trigger_date END) AS moveout
    FROM sequenced
    GROUP BY lotnumber, basictype, pe_gate, grp
)
SELECT
    lotnumber AS lot_id,
    movein,
    moveout,

    /* duration */
    CASE
        WHEN moveout IS NOT NULL THEN (moveout - movein)
        ELSE (SYSDATE - movein)
    END AS time_spent_days,

    CASE
        WHEN moveout IS NOT NULL THEN (moveout - movein) * 1440
        ELSE (SYSDATE - movein) * 1440
    END AS time_spent_minutes,

    basictype,

    /* ✅ Test Mode based on target OP (PE Gate) */
    CASE pe_gate
        WHEN '4150' THEN 'S1'
        WHEN '4250' THEN 'S2'
        WHEN '4350' THEN 'S3'
        ELSE NULL
    END AS test_mode,

    /* PE Gate label */
    CASE pe_gate
        WHEN '4150' THEN 'PE Gate 1'
        WHEN '4250' THEN 'PE Gate 2'
        WHEN '4350' THEN 'PE Gate 3'
        ELSE 'PE Gate ' || pe_gate
    END AS pe_gate,

    /* remark */
    CASE
        WHEN moveout IS NOT NULL THEN
            'Lot_stopped_for_ALF_assessment To Processing_ALF_handling_instructions PE Gate ' || pe_gate
        ELSE
            'Lot_stopped_for_ALF_assessment To Waiting instructions PE Gate ' || pe_gate
    END AS remark
FROM paired
WHERE movein IS NOT NULL
ORDER BY lotnumber, movein;
